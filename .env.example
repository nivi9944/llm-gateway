# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Client keys: apps send one of these as "Authorization: Bearer <key>"
GATEWAY_KEYS=dev-key-1,dev-key-2

# --- Redis (docker compose service name; use redis://localhost:6379/0 when running on the host)
REDIS_URL=redis://redis:6379/0

# --- Providers, tried left to right. Benchmarks override this with "mock".
PROVIDER_ORDER=gemini,ollama
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Use a Flash model that AI Studio lists as free for your key (gemini-3.6-flash on 2026-09-24).
GEMINI_MODEL=gemini-3.6-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# qwen2.5:7b needs ~16 GB RAM; use qwen2.5:3b on an 8 GB laptop.
OLLAMA_MODEL=qwen2.5:7b
MOCK_BASE_URL=http://mock-provider:9000/v1
MOCK_LATENCY_MS=800
MOCK_FAIL_RATE=0.0

# --- Caching
CACHE_TTL_SECONDS=86400
# Two-stage semantic cache: MiniLM + FAISS pick a candidate, a cross-encoder must agree.
# Values from results/qqp_threshold.json (python bench/qqp_threshold.py --two-stage).
SEMANTIC_VERIFY_ENABLED=true
SEMANTIC_CANDIDATE_THRESHOLD=0.85
SEMANTIC_VERIFY_THRESHOLD=0.98
# Used only when SEMANTIC_VERIFY_ENABLED=false (MiniLM alone decides).
SEMANTIC_THRESHOLD=0.98

# --- Rate limit: 10-request burst, then ~10 requests/minute per key
BUCKET_CAPACITY=10
REFILL_PER_SEC=0.1667

# --- Reliability
RETRY_MAX=3
BREAKER_FAILS=5
BREAKER_COOLDOWN_S=30

# --- Cost estimate: Gemini paid-tier list price, USD per 1M tokens (see gateway/config.py)
PRICE_INPUT_PER_M=0.75
PRICE_OUTPUT_PER_M=3.75
